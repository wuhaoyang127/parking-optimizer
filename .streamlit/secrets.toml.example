# 复制本文件为 .streamlit/secrets.toml 并填入真实值。
# 注意：secrets.toml 已被 .gitignore 忽略（匹配 secrets.*），不要提交真实密钥。
#
# 生产部署时，也可以不用本文件，直接在部署平台配置环境变量：
#   SUPABASE_URL / SUPABASE_ANON_KEY

[supabase]
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY = "sb_publishable_你的匿名公钥"

# 车主端推送对接（发布/校验/启用/回滚）。四个值都必须填：
#   PARKING_DRIVER_API_URL  —— 车主端 FastAPI 地址；本机可用 http://127.0.0.1:8000，
#                               其他主机必须是 HTTPS（客户端强制校验）。
#   PARKING_DRIVER_WEB_URL  —— 车主端网页地址（侧边栏「🚗 打开车主端」按钮），可不填。
#   PARKING_PUBLISH_TOKEN / PARKING_ADMIN_TOKEN —— 与车主端服务配置完全一致的
#                               两个不同密钥，至少 32 字符（云端部署时在部署平台
#                               配置同名环境变量或 Secrets，效果相同）。
#   PARKING_DRIVER_CONSOLE_URL —— 未配置 API 时的「打开推送控制台」跳转地址，
#                               本机默认 http://127.0.0.1:8501，可不填。
#   PARKING_CONSOLE_PASSWORD —— 独立控制台（integration_console.py）口令，至少 16 字符。
[driver_bridge]
PARKING_DRIVER_API_URL = "http://127.0.0.1:8000"
PARKING_DRIVER_WEB_URL = "http://127.0.0.1:4173"
PARKING_PUBLISH_TOKEN = "replace-with-the-same-32-plus-character-publish-token-as-driver-api"
PARKING_ADMIN_TOKEN = "replace-with-the-same-32-plus-character-admin-token-as-driver-api"
PARKING_DRIVER_CONSOLE_URL = "http://127.0.0.1:8501"
PARKING_CONSOLE_PASSWORD = "replace-with-at-least-16-character-console-password"
