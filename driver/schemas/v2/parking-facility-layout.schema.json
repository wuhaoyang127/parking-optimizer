        "pixel_height": {
          "minimum": 1,
          "title": "Pixel Height",
          "type": "integer"
        },
        "meters_to_pixels_affine": {
          "maxItems": 6,
          "minItems": 6,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Meters To Pixels Affine",
          "type": "array"
        }
      },
      "required": [
        "pixel_width",
        "pixel_height",
        "meters_to_pixels_affine"
