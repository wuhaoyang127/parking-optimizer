        "channel_zone_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Channel Zone Id",
          "type": "string"
        },
        "capacity": {
          "minimum": 1,
          "title": "Capacity",
          "type": "integer"
        }
      },
      "required": [
        "channel_zone_id",
        "capacity"
      ],
      "title": "ChannelZone",
      "type": "object"
    },
    "Coordinate": {
      "additionalProperties": false,
      "properties": {
        "x_m": {
          "title": "X M",
          "type": "number"
        },
        "y_m": {
          "title": "Y M",
          "type": "number"
        }
      },
      "required": [
        "x_m",
        "y_m"
      ],
      "title": "Coordinate",
      "type": "object"
    },
    "FacilityBounds": {
      "additionalProperties": false,
      "properties": {
        "min_x_m": {
          "title": "Min X M",
          "type": "number"
        },
        "min_y_m": {
          "title": "Min Y M",
          "type": "number"
        },
        "max_x_m": {
          "title": "Max X M",
          "type": "number"
        },
        "max_y_m": {
          "title": "Max Y M",
          "type": "number"
        }
      },
      "required": [
        "min_x_m",
        "min_y_m",
        "max_x_m",
        "max_y_m"
      ],
      "title": "FacilityBounds",
      "type": "object"
    },
    "FacilityBuffer": {
      "additionalProperties": false,
      "properties": {
        "parking_lot_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Parking Lot Id",
          "type": "string"
        },
        "buffer_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Buffer Id",
          "type": "string"
        },
        "floor_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Floor Id",
          "type": "string"
        },
        "zone_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Zone Id",
          "type": "string"
        },
        "geometry": {
          "$ref": "https://parksim.example/schemas/v2/parking-facility-layout.schema.json#/$defs/FacilityRectangle"
        },
        "access_node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Access Node Id",
          "type": "string"
