          "title": "Centerline",
          "type": "array"
        },
        "width_m": {
          "exclusiveMinimum": 0,
          "title": "Width M",
          "type": "number"
        },
        "distance_m": {
          "exclusiveMinimum": 0,
          "title": "Distance M",
          "type": "number"
        },
        "base_travel_time_s": {
          "exclusiveMinimum": 0,
          "title": "Base Travel Time S",
          "type": "number"
        },
        "directed": {
          "default": false,
          "title": "Directed",
          "type": "boolean"
        },
        "traversal_kind": {
          "default": "drive",
          "enum": [
            "drive",
            "ramp",
            "lift"
          ],
          "title": "Traversal Kind",
          "type": "string"
        },
        "channel_zone_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Channel Zone Ids",
          "type": "array"
        }
      },
      "required": [
        "edge_id",
        "from_node_id",
        "to_node_id",
        "centerline",
        "width_m",
        "distance_m",
        "base_travel_time_s"
      ],
