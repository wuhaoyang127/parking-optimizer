      "title": "FacilityBuffer",
      "type": "object"
    },
    "FacilityEdge": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Edge Id",
          "type": "string"
        },
        "from_node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "From Node Id",
          "type": "string"
        },
        "to_node_id": {
          "maxLength": 128,
          "minLength": 1,
