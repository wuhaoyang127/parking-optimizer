{
  "$defs": {
    "DataMode": {
      "enum": [
        "synthetic",
        "real"
      ],
      "title": "DataMode",
      "type": "string"
    },
    "DataSourceStatus": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "parking_lot_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Parking Lot Id",
          "type": "string"
        },
        "mode": {
          "$ref": "https://parksim.example/schemas/v2/parking-lot.schema.json#/$defs/DataMode"
        },
        "health": {
          "$ref": "https://parksim.example/schemas/v2/parking-lot.schema.json#/$defs/HealthStatus"
        },
        "source_name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "missing_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missing Fields",
          "type": "array"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "fail_reason": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fail Reason"
        }
      },
      "required": [
        "parking_lot_id",
        "mode",
        "health",
        "source_name",
        "updated_at"
      ],
      "title": "DataSourceStatus",
      "type": "object"
    },
    "HealthStatus": {
      "enum": [
        "healthy",
        "degraded",
        "unavailable"
      ],
      "title": "HealthStatus",
      "type": "string"
    },
    "PricingSummary": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "const": "CNY",
          "default": "CNY",
          "title": "Currency",
          "type": "string"
        },
        "first_hour_yuan": {
          "minimum": 0,
          "title": "First Hour Yuan",
          "type": "number"
        },
        "additional_hour_yuan": {
          "minimum": 0,
          "title": "Additional Hour Yuan",
          "type": "number"
        },
        "daily_cap_yuan": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Daily Cap Yuan"
        },
        "note": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "first_hour_yuan",
        "additional_hour_yuan",
        "note"
      ],
      "title": "PricingSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "parking_lot_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Parking Lot Id",
      "type": "string"
    },
    "name": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "region_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Region Label",
      "type": "string"
    },
    "venue_type": {
      "enum": [
        "school",
        "hospital",
        "commercial",
        "transport_hub"
      ],
      "title": "Venue Type",
      "type": "string"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    },
    "opening_status": {
      "enum": [
        "open",
        "closed",
        "unknown"
      ],
      "title": "Opening Status",
      "type": "string"
    },
    "total_spaces": {
      "minimum": 1,
      "title": "Total Spaces",
      "type": "integer"
    },
    "available_spaces": {
      "minimum": 0,
      "title": "Available Spaces",
      "type": "integer"
    },
    "charging_spaces": {
      "minimum": 0,
      "title": "Charging Spaces",
      "type": "integer"
    },
    "pricing": {
      "$ref": "https://parksim.example/schemas/v2/parking-lot.schema.json#/$defs/PricingSummary"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "data_source": {
      "$ref": "https://parksim.example/schemas/v2/parking-lot.schema.json#/$defs/DataSourceStatus"
    }
  },
  "required": [
    "parking_lot_id",
    "name",
    "region_label",
    "venue_type",
    "synthetic",
    "opening_status",
    "total_spaces",
    "available_spaces",
    "charging_spaces",
    "pricing",
    "updated_at",
    "data_source"
  ],
  "title": "ParkingLot",
  "type": "object",
  "$id": "https://parksim.example/schemas/v2/parking-lot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
