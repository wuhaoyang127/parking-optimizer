{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "expected_version": {
      "minimum": 1,
      "title": "Expected Version",
      "type": "integer"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "space_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Space Id",
      "type": "string"
    }
  },
  "required": [
    "expected_version",
    "idempotency_key",
    "space_id"
  ],
  "title": "JourneyAlternativeRequest",
  "type": "object",
  "$id": "https://parksim.example/schemas/v2/journey-alternative-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
