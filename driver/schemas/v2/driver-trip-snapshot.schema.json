        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "expected_departure_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Departure At"
        }
      },
      "required": [
        "request_id",
        "idempotency_key",
        "session_id",
        "parking_lot_id",
        "entrance_node_id",
        "requested_at"
      ],
      "title": "DriverRequest",
      "type": "object"
    },
