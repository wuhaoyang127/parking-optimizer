{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parking-opt.local/schemas/v1/decision.schema.json",
  "title": "Decision request or result v1",
  "oneOf": [
    {"$ref": "#/$defs/decisionRequest"},
    {"$ref": "#/$defs/decisionResult"}
  ],
  "$defs": {
    "approvedConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recoverability_policy",
        "rolling_enabled",
        "arrival_wait_capacity",
        "max_arrival_wait_s",
        "max_departure_wait_s",
        "use_soft_departure_information",
        "rolling_window_s",
        "optimization_budget_s",
        "fallback_target_s",
        "minimum_logging_reserve_s",
        "max_requests_per_solve",
        "max_positions_per_arrival",
        "max_buffer_matchings_per_departure",
        "max_action_plans_total",
        "max_soft_future_records",
        "buffer_count",
        "relocation_executor_capacity",
        "executor_type",
        "relocation_setup_s",
        "relocation_speed_mps",
        "active_buffer_position_ids"
      ],
      "properties": {
        "recoverability_policy": {
          "$ref": "common.schema.json#/$defs/recoverabilityPolicy"
        },
        "rolling_enabled": {"type": "boolean"},
        "arrival_wait_capacity": {"type": "integer", "minimum": 0},
        "max_arrival_wait_s": {"$ref": "common.schema.json#/$defs/simTime"},
        "max_departure_wait_s": {"$ref": "common.schema.json#/$defs/simTime"},
        "use_soft_departure_information": {"type": "boolean"},
        "rolling_window_s": {"$ref": "common.schema.json#/$defs/simTime"},
        "optimization_budget_s": {"type": "number", "exclusiveMinimum": 0},
        "fallback_target_s": {"type": "number", "exclusiveMinimum": 0},
        "minimum_logging_reserve_s": {"type": "number", "exclusiveMinimum": 0},
        "max_requests_per_solve": {"type": "integer", "minimum": 1},
        "max_positions_per_arrival": {"type": "integer", "minimum": 1},
        "max_buffer_matchings_per_departure": {"type": "integer", "minimum": 1},
        "max_action_plans_total": {"type": "integer", "minimum": 1},
        "max_soft_future_records": {"type": "integer", "minimum": 0},
        "buffer_count": {"type": "integer", "minimum": 0},
        "relocation_executor_capacity": {"type": "integer", "minimum": 1},
        "executor_type": {"$ref": "common.schema.json#/$defs/executorType"},
        "relocation_setup_s": {"$ref": "common.schema.json#/$defs/nonNegativeNumber"},
        "relocation_speed_mps": {"type": "number", "exclusiveMinimum": 0},
        "active_buffer_position_ids": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/id"},
          "uniqueItems": true
        }
      }
    },
    "decisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "request_id",
        "algorithm_id",
        "algorithm_version",
        "config_sha256",
        "layout_sha256",
        "visible_snapshot_sha256",
        "decision_time_s",
        "trigger_event_id",
        "trigger_event_type",
        "trigger_request_id",
        "trigger_anonymous_vehicle_id",
        "decision_target_s",
        "decision_deadline_s",
        "approved_config",
        "layout",
        "observed_snapshot"
      ],
      "properties": {
        "record_type": {"const": "decision_request"},
        "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
        "request_id": {"$ref": "common.schema.json#/$defs/id"},
        "algorithm_id": {"$ref": "common.schema.json#/$defs/id"},
        "algorithm_version": {"$ref": "common.schema.json#/$defs/id"},
        "config_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "layout_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "visible_snapshot_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "decision_time_s": {"$ref": "common.schema.json#/$defs/simTime"},
        "trigger_event_id": {"$ref": "common.schema.json#/$defs/id"},
        "trigger_request_id": {"$ref": "common.schema.json#/$defs/nullableId"},
        "trigger_anonymous_vehicle_id": {
          "$ref": "common.schema.json#/$defs/nullableId"
        },
        "trigger_event_type": {
          "enum": [
            "ARRIVAL_REQUESTED",
            "DEPARTURE_REQUESTED",
            "ASSIGNMENT_ACCEPTED",
            "USER_CANCELLED",
            "ACTION_ACCEPTED",
            "ACTION_WAITING_FOR_RESOURCES",
            "ACTION_STARTED",
            "ACTION_COMPLETED",
            "ACTION_FAILED_KNOWN_POSITION",
            "ACTION_FAILED_POSITION_UNKNOWN",
            "ABORTED_BEFORE_START",
            "POSITION_RECONCILED",
            "RELOCATION_TRANSACTION_CREATED",
            "TRANSACTION_STAGE_ADVANCED",
            "TRANSACTION_CANCELLED_BEFORE_EXECUTION",
            "TRANSACTION_RECONCILED",
            "MANUAL_STATUS_CHANGED",
            "INFORMATION_UPDATED",
            "DECISION_TIMER_TRIGGERED"
          ]
        },
        "decision_target_s": {"type": "number", "exclusiveMinimum": 0},
        "decision_deadline_s": {"type": "number", "exclusiveMinimum": 0},
        "approved_config": {"$ref": "#/$defs/approvedConfig"},
        "layout": {"$ref": "layout.schema.json"},
        "observed_snapshot": {"$ref": "snapshot.schema.json"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "trigger_event_type": {
                "enum": ["ARRIVAL_REQUESTED", "DEPARTURE_REQUESTED"]
              }
            },
            "required": ["trigger_event_type"]
          },
          "then": {
            "properties": {
              "trigger_request_id": {"$ref": "common.schema.json#/$defs/id"},
              "trigger_anonymous_vehicle_id": {
                "$ref": "common.schema.json#/$defs/id"
              }
            }
          }
        }
      ]
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "end_to_end_s",
        "validation_and_modeling_s",
        "solver_s",
        "postsolve_validation_s",
        "minimum_logging_s",
        "solver_time_limit_s"
      ],
      "properties": {
        "end_to_end_s": {"$ref": "common.schema.json#/$defs/nonNegativeNumber"},
        "validation_and_modeling_s": {"$ref": "common.schema.json#/$defs/nonNegativeNumber"},
        "solver_s": {"$ref": "common.schema.json#/$defs/nonNegativeNumber"},
        "postsolve_validation_s": {"$ref": "common.schema.json#/$defs/nonNegativeNumber"},
        "minimum_logging_s": {"$ref": "common.schema.json#/$defs/nonNegativeNumber"},
        "solver_time_limit_s": {"$ref": "common.schema.json#/$defs/nonNegativeNumber"}
      }
    },
    "candidateGenerationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests_seen",
        "requests_kept",
        "positions_seen",
        "positions_kept",
        "buffer_matchings_seen",
        "buffer_matchings_kept",
        "action_plans_kept",
        "truncation_reasons"
      ],
      "properties": {
        "requests_seen": {"type": "integer", "minimum": 0},
        "requests_kept": {"type": "integer", "minimum": 0},
        "positions_seen": {"type": "integer", "minimum": 0},
        "positions_kept": {"type": "integer", "minimum": 0},
        "buffer_matchings_seen": {"type": "integer", "minimum": 0},
        "buffer_matchings_kept": {"type": "integer", "minimum": 0},
        "action_plans_kept": {"type": "integer", "minimum": 0},
        "truncation_reasons": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 128},
          "uniqueItems": true
        }
      }
    },
    "decisionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "decision_id",
        "request_id",
        "algorithm_id",
        "algorithm_version",
        "config_sha256",
        "layout_sha256",
        "visible_snapshot_sha256",
        "input_model_sha256",
        "target_request_id",
        "target_anonymous_vehicle_id",
        "primary_decision",
        "recommended_actions",
        "candidate_transaction",
        "solver_status",
        "fallback_record",
        "validation_status",
        "explanation_codes",
        "candidate_generation",
        "timing"
      ],
      "properties": {
        "record_type": {"const": "decision_result"},
        "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
        "decision_id": {"$ref": "common.schema.json#/$defs/id"},
        "request_id": {"$ref": "common.schema.json#/$defs/id"},
        "algorithm_id": {"$ref": "common.schema.json#/$defs/id"},
        "algorithm_version": {"$ref": "common.schema.json#/$defs/id"},
        "config_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "layout_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "visible_snapshot_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "input_model_sha256": {
          "oneOf": [
            {"$ref": "common.schema.json#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "target_request_id": {"$ref": "common.schema.json#/$defs/id"},
        "target_anonymous_vehicle_id": {"$ref": "common.schema.json#/$defs/id"},
        "primary_decision": {
          "enum": [
            "RECOMMEND_ACTIONS",
            "WAIT",
            "REJECT",
            "REQUEST_MANUAL_INTERVENTION"
          ]
        },
        "recommended_actions": {
          "type": "array",
          "items": {
            "allOf": [
              {"$ref": "common.schema.json#/$defs/action"},
              {"properties": {"status": {"const": "RECOMMENDED"}}}
            ]
          }
        },
        "candidate_transaction": {
          "oneOf": [
            {
              "allOf": [
                {"$ref": "common.schema.json#/$defs/transaction"},
                {"properties": {"status": {"const": "PROPOSED"}}}
              ]
            },
            {"type": "null"}
          ]
        },
        "solver_status": {"$ref": "common.schema.json#/$defs/solverStatus"},
        "fallback_record": {
          "oneOf": [
            {"$ref": "common.schema.json#/$defs/fallbackRecord"},
            {"type": "null"}
          ]
        },
        "validation_status": {"$ref": "common.schema.json#/$defs/validationStatus"},
        "explanation_codes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 128},
          "uniqueItems": true
        },
        "candidate_generation": {
          "oneOf": [
            {"$ref": "#/$defs/candidateGenerationRecord"},
            {"type": "null"}
          ]
        },
        "timing": {"$ref": "#/$defs/timing"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"primary_decision": {"const": "RECOMMEND_ACTIONS"}},
            "required": ["primary_decision"]
          },
          "then": {
            "properties": {"recommended_actions": {"minItems": 1}}
          },
          "else": {
            "properties": {
              "recommended_actions": {"maxItems": 0},
              "candidate_transaction": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
