# 停车场优化系统 — 研发端 HTTPS 反向代理示例（nginx）
# 用法：
#   1. 把 server_name 换成你的域名；证书路径换成实际文件（Let's Encrypt 等）
#   2. 复制到 /etc/nginx/conf.d/parking.conf 并重载 nginx
#   3. Streamlit 应用跑在 127.0.0.1:8501
server {
    listen 80;
    server_name parking-rd.example.com;
    # HTTP 自动跳转 HTTPS（可选）
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name parking-rd.example.com;

    ssl_certificate     /etc/letsencrypt/live/parking-rd.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/parking-rd.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # 上传布局/需求文件的大小限制
    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;

        # Streamlit 依赖 WebSocket，必须升级连接
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 长连接与超时（页面可能长时间运行仿真）
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # Streamlit 健康检查端点（供监控探活）
    location /_stcore/health {
        proxy_pass http://127.0.0.1:8501/_stcore/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
}
